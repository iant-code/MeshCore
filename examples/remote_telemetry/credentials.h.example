#pragma once

// ****** RENAME to credentials.h and FILL IN YOUR DEFAULTS ******

// Default MQTT credentials applied when WiFiManager fields are left blank.
// Update these values with deployment-specific details; this file is excluded
// from source control so each environment can provide its own defaults.
namespace remote_telemetry {
namespace defaults {

// Broker host, e.g. "mqtt.example.com". Leave empty to require manual entry.
inline constexpr const char* MQTT_HOST = "";

// Username used when the host falls back to MQTT_HOST and the user leaves
// the WiFiManager field blank.
inline constexpr const char* MQTT_USERNAME = "";

// Password used when the host falls back to MQTT_HOST and the user leaves
// the WiFiManager field blank.
inline constexpr const char* MQTT_PASSWORD = "";

// URL the node checks for firmware updates in response to the MQTT
// "update_firmware" control command. Must be HTTPS (the node does not
// validate the server certificate) and serve the .bin built for this
// exact board/environment, returning an accurate Last-Modified header.
inline constexpr const char* FIRMWARE_UPDATE_URL = "";

}  // namespace defaults
}  // namespace remote_telemetry
